<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>RocketLauncher</AssemblyName>
    <RootNamespace>RocketLauncher</RootNamespace>
    <ApplicationIcon>assets\rocket.ico</ApplicationIcon>
    <ApplicationManifest>assets\app.manifest</ApplicationManifest>
    <Product>Rocket</Product>
    <AssemblyTitle>Rocket Launcher</AssemblyTitle>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <EmbeddedResource Include="assets\Logo.png" LogicalName="RocketLauncher.Logo.png" />
    <None Include="RocketLauncher.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
